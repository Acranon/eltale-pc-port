+};
+Gfx text_glyph_setup_dl[20] = {
+    {{ 0xE7000000, 0x00000000 }},
+    {{ 0xBA001402, 0x00000000 }},
+    {{ 0xBA001301, 0x00000000 }},
+    {{ 0xB900031D, 0x0F0A4000 }},
+    {{ 0xB6000000, 0x000F3205 }},
+    {{ 0xB7000000, 0x00000004 }},
