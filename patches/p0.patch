+s32 text_font_index;
+s32 text_extra_glyph_spacing;
+
+void Text_CopyTerminatedBytes(u8 *dst, u8 *src) {
+    s32 i = 0;
+
+    while (src[i] != 0xFF) {
+        dst[i] = src[i];
+        i++;
+    }
+    dst[i] = 0xFF;
+}
+
+void Text_LoadFontAssets(void) {
+    Dma_ReadRom(D_D3A8B0, D_80332D30, 0x80);
+    Dma_ReadRom(D_D3A930, D_803245A0, 0xE790);
+#ifdef ELTALE_P1_OS
+    Port_TextFontLoaded();
+#endif
+}
+
+void Text_DrawEncodedString(s32 x0, s32 y0, u8 *str) {
+    s32 x = x0;
+    s32 y = y0;
+    s32 c;
+#ifdef ELTALE_P1_OS
+    s32 page = 0;
+    s32 left;
+    s32 w;
+
+    str = (u8 *)Port_TextTranslate(str);
+#endif
+
+    gDPPipeSync(gfx_dl_head++);
+    gDPSetTextureLUT(gfx_dl_head++, G_TT_RGBA16);
+    for (; *str != 0xFF; str++) {
+        if (*str & 0x80) {
+            c = *str & 0x1F;
+            switch (*str & 0x60) {
+                case 0x00:
+#ifdef ELTALE_P1_OS
+                    /* English: the port's extra page (port/text/en_text.c) */
+                    page = c;
+                    if (c >= 30) {
+                        gDPLoadTextureTile_4b(gfx_dl_head++, Port_TextExtraPage(c), G_IM_FMT_CI, 304, 13, 0, 0, 303, 12, 0, 0, 0, 0, 0, 0, 0);
+                        break;
+                    }
+#endif
+                    gDPLoadTextureTile_4b(gfx_dl_head++, D_803245A0 + c * 0x7B8, G_IM_FMT_CI, 304, 13, 0, 0, 303, 12, 0, 0, 0, 0, 0, 0, 0);
+                    break;
+                case 0x20:
+                    gDPLoadTLUT_pal16(gfx_dl_head++, 0, (u16 *) D_80332D30 + c * 16);
+                    break;
+                case 0x40:
+                    if (c < 16) {
+                        text_font_index = c;
+                    } else {
+                        text_extra_glyph_spacing = c;
+                    }
+                    break;
+                case 0x60:
+                    switch (c) {
+                        case 0x13:
+                            break;
+                        case 0x14:
+                            break;
+                        case 0x1E:
+                            gSPDisplayList(gfx_dl_head++, text_glyph_setup_dl);
+                            break;
+                        case 0:
+                            x = x0;
+#ifdef ELTALE_P1_OS
+                            if (text_font_index == 1) {
+                                y += text_font_metrics[0].line_height;
+                                break;
+                            }
+#endif
+                            y += text_font_metrics[text_font_index].line_height;
+                            break;
+                    }
+                    break;
+            }
+        } else {
+            c = *str & 0x7F;
+#ifdef ELTALE_P1_OS
+            /* English (font 1): the glyphs spaced by their own width */
+            if (text_font_index == 1) {
+                if (*str == 0x7F) {
+                    x += Port_TextSpaceWidth();
+                } else {
+                    w = Port_TextGlyphWidth(page, c, &left);
+                    gSPTextureRectangle(gfx_dl_head++, x << 2, y << 2, (x + w) << 2, (y + 13) << 2, G_TX_RENDERTILE,
+                                        (c * 10 + left) << 5, 0, 1 << 10, 1 << 10);
+                    x += w;
+                }
+                continue;
+            }
+#endif
+            if (*str == 0x7F) {
+                x += text_font_metrics[text_font_index].advance + text_extra_glyph_spacing;
+            } else {
+                gSPTextureRectangle(gfx_dl_head++, x << 2, y << 2, (x + text_font_metrics[text_font_index].width) << 2, (text_font_metrics[text_font_index].height + y) << 2, G_TX_RENDERTILE,
+                                    (text_font_metrics[text_font_index].width * c) << 5, 0, 1 << 10, 1 << 10);
+                x += text_font_metrics[text_font_index].advance + text_extra_glyph_spacing;
+            }
+        }
+    }
+    gDPPipeSync(gfx_dl_head++);
+    gDPSetTextureLUT(gfx_dl_head++, G_TT_NONE);
+#ifdef ELTALE_P1_OS
+    if (text_font_index == 1) {
+        text_font_index = 0;
+    }
+#endif
+}
